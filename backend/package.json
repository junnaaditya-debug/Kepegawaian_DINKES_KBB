{
  "name": "simpeg-dinkes-kbb-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply simpeg_dinkes_kbb --local",
    "db:migrate:remote": "wrangler d1 migrations apply simpeg_dinkes_kbb --remote",
    "db:seed:local": "wrangler d1 execute simpeg_dinkes_kbb --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute simpeg_dinkes_kbb --remote --file=./seed/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "pdf-lib": "^1.17.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
