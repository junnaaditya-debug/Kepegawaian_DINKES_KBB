{
  "name": "simpeg-dinkes-kbb-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply simpeg-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply simpeg-db --remote",
    "generate-seed": "tsx scripts/generate-seed.ts",
    "seed:local": "npm run generate-seed && wrangler d1 execute simpeg-db --local --file=./seed.sql",
    "seed:remote": "npm run generate-seed && wrangler d1 execute simpeg-db --remote --file=./seed.sql",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "hono": "^4.6.11",
    "pdf-lib": "^1.17.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.5.5",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "wrangler": "^4.120.1"
  }
}
